EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set these as Supabase Edge Function secrets, not Expo public env vars.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_VISION_MODEL=gpt-5.6-luna

# Face Scan Lab server only; never use an EXPO_PUBLIC_ prefix.
YOUCAM_API_KEY=
# Required for hosted prototype access; optional for local loopback development.
FACE_SCAN_PROTOTYPE_PASSWORD=
# Optional; use a stable secret to keep saved task references valid when rotating the API key.
FACE_SCAN_SIGNING_SECRET=
